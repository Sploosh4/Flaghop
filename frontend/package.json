{
  "name": "flaghop-workspace-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/api/schema.ts --default-non-nullable false",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test": "vitest run"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^21.0.4",
    "openapi-typescript": "^7.13.0",
    "typescript": "5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
